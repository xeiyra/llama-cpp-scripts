# ------------------------------------------------------------------
# example.env
#
# Copy to `.env` in the same directory as launch-llama-server.sh and
# generate-models-preset.sh. Both scripts read this file directly
# (no `source` — just plain KEY=value parsing), and only apply a
# value if that variable isn't already set in your real shell
# environment, so a one-off override like:
#   BIN_PATH=/tmp/test-build ./launch-llama-server.sh
# still wins over whatever is in .env.
#
# Lines starting with # and blank lines are ignored. Quotes around
# values are optional and get stripped if present.
# ------------------------------------------------------------------

# --- launch-llama-server.sh ---
# Every *_VALUE / *_ENABLED setting the script defines is now overridable
# here. Anything you don't set falls back to the script's built-in
# default (shown below, matching the script as shipped).

# Path to your llama.cpp build's bin directory
BIN_PATH=${HOME}/ai-stack/engines/llama.cpp/build/bin/

# --- Network ---
HOST_VALUE=127.0.0.1           # 127.0.0.1 for localhost-only, 0.0.0.0 for LAN
HOST_ENABLED=ON
PORT_VALUE=8011
PORT_ENABLED=ON

# API key for llama-server, if you use API_KEY_ENABLED=ON. Leave blank if
# you don't require auth. Prefer setting this via a real env var/secrets
# manager rather than committing it to .env, e.g.:
#   API_KEY_VALUE="$(pass show llama-server-key)" ./launch-llama-server.sh
API_KEY_VALUE=
API_KEY_ENABLED=OFF

# Allows binding to a non-localhost HOST_VALUE without an API key set.
# Only set to 1 on a trusted LAN — see the script's safety-check comment.
ALLOW_UNAUTHENTICATED=0

# --- Model routing (models-preset.ini) ---
MODELS_PRESET_VALUE=${HOME}/ai-stack/models/models-preset.ini
MODELS_PRESET_ENABLED=ON
MODELS_MAX_VALUE=1            # how many models loaded concurrently before eviction
MODELS_MAX_ENABLED=ON

# --- Performance / threading ---
THREADS_VALUE=16               # -t — leave ENABLED=OFF to let llama.cpp auto-detect
THREADS_ENABLED=OFF
THREADS_HTTP_VALUE=4           # HTTP worker threads, separate from inference threads
THREADS_HTTP_ENABLED=OFF
PARALLEL_VALUE=1               # -np — parallel request slots
PARALLEL_ENABLED=OFF
CONT_BATCHING_ENABLED=OFF      # -cb — continuous batching (flag, no value)
FLASH_ATTN_ENABLED=OFF         # -fa — flash attention (flag, no value on most builds)

# --- Context / GPU overrides ---
# (usually left OFF since models-preset.ini's fit-ctx/fit-target already
# control this per-model)
CTX_SIZE_VALUE=65536           # -c — overrides fit-ctx if enabled
CTX_SIZE_ENABLED=OFF
N_GPU_LAYERS_VALUE=999         # -ngl — overrides fit-target's auto layer split if enabled
N_GPU_LAYERS_ENABLED=OFF

# --- Memory behavior ---
MLOCK_ENABLED=OFF              # --mlock — lock model in RAM, no swap
NO_MMAP_ENABLED=OFF            # --no-mmap — disable mmap loading

# --- Logging / debugging ---
LOG_TIMESTAMPS_ENABLED=ON      # --log-timestamps (flag, no value)
VERBOSITY_VALUE=1              # -v / --verbosity — higher = more logs
VERBOSITY_ENABLED=OFF

# --- API / endpoints ---
NO_WEBUI_ENABLED=OFF           # --no-webui — disable the built-in web UI
METRICS_ENABLED=OFF            # --metrics — expose Prometheus metrics endpoint
SLOTS_ENDPOINT_ENABLED=OFF     # --slots — expose /slots endpoint
EMBEDDINGS_ENABLED=OFF         # --embeddings — enable embedding endpoint

# --- install-llama_cpp.sh ---
# Every one of these is independently overridable. CLONE_DIR, BUILD_DIR,
# and BUILDS_ARCHIVE_DIR each default to ROOT_DIR/<name> if not set
# explicitly, so you normally only need to set ROOT_DIR — but you can
# also point any one of them somewhere else on its own (e.g. keep the
# build output on a faster disk while the source checkout stays on
# ROOT_DIR).

ROOT_DIR=${HOME}/ai-stack/engines/llama.cpp

# Uncomment any of these to override their default relative to ROOT_DIR:
# CLONE_DIR=${HOME}/ai-stack/engines/llama.cpp/llama.cpp
# BUILD_DIR=${HOME}/ai-stack/engines/llama.cpp/build
# BUILDS_ARCHIVE_DIR=${HOME}/ai-stack/engines/llama.cpp/builds

BUILD_TYPE=Release              # Release, Debug, RelWithDebInfo, etc.
GGML_HIP=ON                     # ON to build with ROCm/HIP, OFF for CPU-only
GGML_CCACHE=OFF                 # Whether to enable ccache for faster rebuilds
ALLOW_DIRTY=0                   # 1 to skip the confirmation prompt when
                                  # CLONE_DIR has uncommitted local changes

# --- ROCm/HIP paths (overridable via .env) ---
# These are set after .env loads, so you can point them elsewhere if needed.
# HIP_PATH auto-detects via `hipconfig -R`, falling back to /opt/rocm.
# ROCM_PATH=/opt/rocm
# HIP_PATH=
# HIPCXX=

# --- generate-models-preset.sh ---

# Directory to scan for models (equivalent to the first positional arg;
# only used if you don't pass one on the command line)
MODELS_DIR=${HOME}/ai-stack/models/llm

# Output preset file (equivalent to the second positional arg; only
# used if you don't pass one on the command line)
OUT_FILE=${HOME}/ai-stack/models/models-preset.ini

# Optional: set to 0 to name entries after the model folder only,
# instead of "quantizer_modelname" (default: 1)
PREFIX_QUANTIZER=1

# Optional: comma-separated, case-insensitive list of trailing "-suffix"
# strings to strip from model folder names before building the preset
# name (default: GGUF). Set to an empty value to disable stripping.
STRIP_SUFFIXES=GGUF

# Optional: extra "key = value" lines applied to every generated preset
# section (e.g. fit-target, fit-ctx). This needs literal newlines, which
# the simple .env parser here doesn't support directly — use \n and the
# script will unescape it, e.g.:
EXTRA_ARGS=fit-target = 2048\nfit-ctx = 65536
